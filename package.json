{
  "name": "jack-video-fusion",
  "version": "2.0.1",
  "description": "AI?????? - Windows?????I????????????",
  "author": "jackgoogle <13861419@qq.com>",
  "license": "MIT",
  "main": "dist-electron/electron/bootstrap.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently -k -n vite,tsc,electron -c blue,green,yellow \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "node scripts/vue-tsc.cjs --noEmit && vite build",
    "build:electron": "node scripts/vue-tsc.cjs --noEmit && vite build && tsc -p tsconfig.electron.json",
    "package": "npm run build:electron && electron-builder",
    "package:win": "npm run build:electron && electron-builder --win --x64",
    "typecheck": "node scripts/vue-tsc.cjs --noEmit",
    "test": "node --test --import tsx \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.9",
    "fluent-ffmpeg": "^2.1.3",
    "msedge-tts": "^1.3.4",
    "onnxruntime-node": "^1.27.0",
    "pinia": "^2.2.4",
    "playwright-core": "^1.62.1",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.7.5",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "less": "^4.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^5.4.9",
    "vue-tsc": "^3.3.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.jackvideo.fusion",
    "productName": "AI??????",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "executableName": "JackVideoFusion",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "JackVideoFusion-${version}-${arch}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JACK-AI-20260531",
        "repo": "JackVideoFusion"
      }
    ],
    "electronUpdaterCompatibility": "latest.yml",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "afterPack": "scripts/postbuild-fix-asar.cjs"
  }
}
